# Leave blank until you are ready to use real OpenRouter inference.
OPENROUTER_API_KEY=

# Keep true for local development without API spend.
# Set to false after adding a valid OpenRouter key.
USE_MOCK_INFERENCE=true

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Optional OpenRouter metadata headers.
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Adaptive Inference Scheduler

# Runtime evidence path.
REQUEST_LOG_PATH=data/request_logs.jsonl

# Backend config path.
BACKENDS_CONFIG_PATH=config/backends.json
